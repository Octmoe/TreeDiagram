{
  "name": "treediagram",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "packages/storage-sqlite",
    "packages/attention",
    "packages/mcp",
    "packages/ui-core",
    "apps/sidecar"
  ],
  "scripts": {
    "dev": "npm run build && node apps/sidecar/dist/server/index.js",
    "dev:web": "npm run dev -w @treediagram/sidecar",
    "build:packages": "tsc -b",
    "build": "tsc -b && npm run build:web -w @treediagram/sidecar",
    "typecheck": "tsc -b && tsc -p apps/sidecar/tsconfig.web.json && tsc -p tests/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project contract-domain",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "workspace:init": "node packages/storage-sqlite/dist/cli.js init",
    "seed:demo": "node packages/storage-sqlite/dist/cli.js seed",
    "mcp": "node packages/mcp/dist/stdio.js",
    "start": "node apps/sidecar/dist/server/index.js",
    "plugin:prepare": "npm run build && node scripts/prepare-local-plugin.mjs",
    "install:codex": "node scripts/codex-source.mjs install",
    "update:codex": "node scripts/codex-source.mjs update",
    "uninstall:codex": "node scripts/codex-source.mjs uninstall",
    "version:set": "node scripts/set-version.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "try:codex": "npm run plugin:prepare && node plugins/treediagram/scripts/project.mjs start --workspace .",
    "treediagram:start": "node plugins/treediagram/scripts/project.mjs start",
    "treediagram:open": "node plugins/treediagram/scripts/project.mjs open",
    "treediagram:status": "node plugins/treediagram/scripts/project.mjs status",
    "treediagram:stop": "node plugins/treediagram/scripts/project.mjs stop"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
